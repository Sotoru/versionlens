{
  "manifestVersion": 2,
  "id": "versionlens",
  "name": "Version Lens",
  "version": "0.2.0",
  "description": "See newer npm versions for every package.json dependency, update them in place, read changelogs, and catch peer conflicts and known vulnerabilities.",
  "engines": {
    "orca": ">=1.4.259"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "settings": [
      {
        "key": "agent",
        "title": "Agent for \"Update with agent\"",
        "description": "Which agent CLI Orca starts to update the dependencies.",
        "type": "string",
        "default": "claude",
        "enum": ["claude", "codex", "opencode", "gemini", "cursor", "copilot"],
        "enumLabels": ["Claude Code", "Codex", "OpenCode", "Gemini CLI", "Cursor", "GitHub Copilot"]
      }
    ],
    "panels": [
      {
        "id": "versionlens",
        "title": "Version Lens",
        "icon": "package",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "versionlens.check",
        "title": "Version Lens: Check Dependencies",
        "when": "workspace"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "statusBarItems": [
      {
        "id": "versionlens",
        "text": "Version Lens",
        "icon": "package",
        "tooltip": "Version Lens: press to check this workspace's dependencies",
        "command": "versionlens.check"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "terminal:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "settings:own"
    }
  ]
}
